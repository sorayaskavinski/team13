@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<div class="taskforge-layout">

    <!-- TaskForge Navigation -->
    <header class="taskforge-navbar">

        <div class="taskforge-nav-container">

            <!-- Logo -->
            <a href="/" class="taskforge-logo">
                Task<span>Forge</span>
            </a>

            <!-- Navigation Links -->
            <nav class="taskforge-nav-links">

                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    Home
                </NavLink>

                <NavLink class="nav-link" href="dashboard">
                    Dashboard
                </NavLink>

                <NavLink class="nav-link" href="tasks">
                    Tasks
                </NavLink>

                <NavLink class="nav-link" href="tasks/create">
                    + Task
                </NavLink>

                <NavLink class="nav-link" href="projects/create">
                    + Project
                </NavLink>

                <!-- Authentication View (Login / User Account / Register) -->
                <AuthorizeView>
                    <Authorized>

                       <NavLink href="Account/Manage">
                            <button type="submit" class="user-profile-button">
                                USER PROFILE
                            </button>
                        </NavLink>             
                    

                        <!-- Logout Form -->
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit" class="taskforge-nav-button logout-btn">
                                Logout
                            </button>
                        </form>
                        
                    </Authorized>

                    <NotAuthorized>
                        <a href="Account/Login" class="nav-link">
                            Sign In
                        </a>

                        <a href="Account/Register" class="taskforge-nav-button">
                            Get Started
                        </a>
                    </NotAuthorized>
                </AuthorizeView>

            </nav>

        </div>

    </header>

    <!-- Page Content -->
    <main>
        @Body
    </main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}