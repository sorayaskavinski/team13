@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Team13.Data
@using Team13.Models

@inject IDbContextFactory<Team13Context> DbFactory
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Dashboard - TaskForge</PageTitle>

<div class="dashboard-page">

    <!-- Dashboard Header -->
    <div class="dashboard-header d-flex justify-content-between align-items-center">
        
        <div>
            <p class="dashboard-eyebrow">TASKFORGE</p>
            <h1>Dashboard</h1>
            <p>View your projects, tasks, and overall progress.</p>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="text-end me-3">
                    <small class="text-muted">Logged in as</small>
                    <div class="fw-semibold">@context.User.Identity?.Name</div>

                    <button @onclick="LogoutUser" class="btn btn-outline-danger btn-sm mt-2">
                        Logout
                    </button>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="text-end me-3">
                    <span class="text-muted">Not logged in</span>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <div class="header-actions">
            <a href="projects/create" class="btn btn-outline-primary me-2">+ New Project</a>
            <a href="tasks/create" class="btn btn-primary">+ New Task</a>
        </div>
    </div>

    <!-- Search and Filters -->
    <div class="dashboard-controls">
        <div class="search-box">
            <span>🔍</span>
            <input type="text"
                   placeholder="Search projects or tasks..."
                   @bind="SearchText"
                   @bind:event="oninput" />
        </div>

        <select @bind="SelectedStatus">
            <option value="All">All Status</option>
            <option value="To Do">To Do</option>
            <option value="In Progress">In Progress</option>
            <option value="Completed">Completed</option>
        </select>

        <select @bind="SelectedPriority">
            <option value="All">All Priorities</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
            <option value="Low">Low</option>
        </select>
    </div>

    <!-- Overview Statistics -->
    <section class="dashboard-section">
        <div class="section-heading">
            <div>
                <h2>Overview</h2>
                <p>Click any card to filter your tasks.</p>
            </div>
        </div>

        <div class="dashboard-stats">
            <div class="stat-card clickable @(SelectedStatus == "All" ? "active-stat" : "")" @onclick='() => FilterByStatus("All")'>
                <div class="stat-icon">📁</div>
                <div>
                    <p>Total Projects</p>
                    <h2>@TotalProjects</h2>
                </div>
            </div>

            <div class="stat-card clickable @(SelectedStatus == "All" ? "active-stat" : "")" @onclick='() => FilterByStatus("All")'>
                <div class="stat-icon">📝</div>
                <div>
                    <p>Total Tasks</p>
                    <h2>@TotalTasks</h2>
                </div>
            </div>

            <div class="stat-card clickable @(SelectedStatus == "In Progress" ? "active-stat" : "")" @onclick='() => FilterByStatus("In Progress")'>
                <div class="stat-icon">🔄</div>
                <div>
                    <p>In Progress</p>
                    <h2>@InProgressTasksCount</h2>
                </div>
            </div>

            <div class="stat-card clickable @(SelectedStatus == "Completed" ? "active-stat" : "")" @onclick='() => FilterByStatus("Completed")'>
                <div class="stat-icon">✅</div>
                <div>
                    <p>Completed Tasks</p>
                    <h2>@CompletedTasksCount</h2>
                </div>
            </div>
        </div>
    </section>

    <!-- My Projects Section -->
    <section class="dashboard-section">
        <div class="section-heading">
            <div>
                <h2>My Projects</h2>
                <p>View projects you are working on.</p>
            </div>
            <span class="result-count">
                @FilteredProjects.Count() projects
            </span>
        </div>

        @if (!FilteredProjects.Any())
        {
            <p class="text-muted">No projects found matching your criteria.</p>
        }
        else
        {
            <div class="project-grid">
                @foreach (var project in FilteredProjects)
                {
                    var projectTasks = project.Tasks ?? new List<Team13.Models.Task>();
                    var totalPTasks = projectTasks.Count;
                    var completedPTasks = projectTasks.Count(t => IsTaskDone(t.Status));
                    var progressPercentage = totalPTasks > 0 ? (int)Math.Round((double)completedPTasks / totalPTasks * 100) : 0;

                    <div class="project-card">
                        <div class="project-card-top">
                            <div>
                                <h3>@project.Name</h3>
                                <p>@project.Description</p>
                            </div>
                        </div>

                        <div class="project-progress">
                            <div class="progress-info">
                                <span>Progress</span>
                                <span>@progressPercentage%</span>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width: @(progressPercentage)%;"></div>
                            </div>
                        </div>

                        <div class="project-footer">
                            <span>@totalPTasks tasks</span>
                            <span class="badge bg-secondary">@completedPTasks / @totalPTasks Done</span>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- My Tasks Section -->
    <section class="dashboard-section">
        <div class="section-heading">
            <div>
                <h2>My Tasks</h2>
                <p>Click on the checkbox next to any task to toggle its completion status.</p>
            </div>
            <span class="result-count">
                @FilteredTasks.Count() tasks
            </span>
        </div>

        @if (!FilteredTasks.Any())
        {
            <p class="text-muted">No tasks found matching your criteria.</p>
        }
        else
        {
            <div class="task-list">
                @foreach (var task in FilteredTasks)
                {
                    var isCompleted = IsTaskDone(task.Status);

                    <div class="dashboard-task">
                        <div class="task-check @(isCompleted ? "completed" : "")"
                             @onclick="() => ToggleTaskCompletion(task)"
                             title="Click to toggle status">
                        </div>

                        <div class="task-details">
                            <h3>@task.Title</h3>
                            <p>@(task.Project?.Name ?? "No Project")</p>
                        </div>

                        <span class="priority @((task.Priority ?? "").ToLower())">
                            @(task.Priority ?? "Normal")
                        </span>

                        <span class="task-status @(isCompleted ? "completed-text" : "")">
                            @(task.Status ?? "To Do")
                        </span>
                    </div>
                }
            </div>
        }
    </section>

</div>

@code {
    private string SearchText = "";
    private string SelectedStatus = "All";
    private string SelectedPriority = "All";

    private List<Team13.Models.Project> Projects = new();
    private List<Team13.Models.Task> Tasks = new();

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async System.Threading.Tasks.Task LoadDataAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            Projects = new List<Team13.Models.Project>();
            Tasks = new List<Team13.Models.Task>();
            return;
        }

        var currentUser = await UserManager.GetUserAsync(user);
        if (currentUser == null)
        {
            Projects = new List<Team13.Models.Project>();
            Tasks = new List<Team13.Models.Task>();
            return;
        }

        var currentUserId = currentUser.Id;

        using var context = await DbFactory.CreateDbContextAsync();

        // Carrega projetos e tarefas criados exclusivamente por esta conta
        Projects = await context.Set<Team13.Models.Project>()
            .Where(p => p.CreatedByUserId == currentUserId)
            .Include(p => p.Tasks)
            .AsNoTracking()
            .ToListAsync();

        Tasks = await context.Set<Team13.Models.Task>()
            .Where(t => t.CreatedByUserId == currentUserId || (t.Project != null && t.Project.CreatedByUserId == currentUserId))
            .Include(t => t.Project)
            .Include(t => t.AssignedUser)
            .AsNoTracking()
            .ToListAsync();
    }

    private void LogoutUser()
    {
        NavManager.NavigateTo("Account/Logout", forceLoad: true);
    }

    private void FilterByStatus(string status)
    {
        SelectedStatus = status;
        StateHasChanged();
    }

    private async System.Threading.Tasks.Task ToggleTaskCompletion(Team13.Models.Task task)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var dbTask = await context.Set<Team13.Models.Task>().FindAsync(task.TaskId);
        if (dbTask != null)
        {
            dbTask.Status = IsTaskDone(dbTask.Status) ? "To Do" : "Completed";

            await context.SaveChangesAsync();
            await LoadDataAsync();
        }
    }

    private static bool IsTaskDone(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return false;
        var s = status.Trim();
        return string.Equals(s, "Completed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(s, "Complete", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(s, "Done", StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<Team13.Models.Project> FilteredProjects =>
        Projects.Where(project =>
            (string.IsNullOrWhiteSpace(SearchText) ||
             (project.Name != null && project.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
             (project.Description != null && project.Description.Contains(SearchText, StringComparison.OrdinalIgnoreCase)))
        );

    private IEnumerable<Team13.Models.Task> FilteredTasks =>
        Tasks.Where(task =>
            (string.IsNullOrWhiteSpace(SearchText) ||
             (task.Title != null && task.Title.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
             (task.Project?.Name != null && task.Project.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase)))
            &&
            (SelectedStatus == "All" ||
             (SelectedStatus == "Completed" && IsTaskDone(task.Status)) ||
             string.Equals(task.Status, SelectedStatus, StringComparison.OrdinalIgnoreCase))
            &&
            (SelectedPriority == "All" ||
             string.Equals(task.Priority, SelectedPriority, StringComparison.OrdinalIgnoreCase))
        );

    private int TotalProjects => Projects.Count;
    private int TotalTasks => Tasks.Count;
    private int InProgressTasksCount => Tasks.Count(t => string.Equals(t.Status, "In Progress", StringComparison.OrdinalIgnoreCase));
    private int CompletedTasksCount => Tasks.Count(t => IsTaskDone(t.Status));
}