@page "/"

<PageTitle>TaskForge - Build. Track. Deliver.</PageTitle>

<div class="taskforge-home">

    <!-- Navigation -->
    <header class="navbar">

        <div class="nav-container">

            <a href="/" class="logo">
                Task<span>Forge</span>
            </a>

            <nav class="nav-links">
                <a href="#features">Features</a>
                <a href="#how-it-works">How It Works</a>
                <a href="#">Sign In</a>

                <a href="#" class="nav-button">
                    Get Started
                </a>
            </nav>

        </div>

    </header>


    <!-- Hero -->
    <section class="hero">

        <div class="hero-container">

            <div class="hero-content">

                <p class="eyebrow">
                    TEAM PROJECT MANAGEMENT
                </p>

                <h1>
                    Build. Track.
                    <span>Deliver.</span>
                </h1>

                <p class="hero-description">
                    Manage projects, organize tasks, assign team members,
                    and track your team's progress all in one place.
                </p>

                <div class="hero-buttons">

                    <a href="#" class="primary-button">
                        Get Started
                    </a>

                    <a href="#features" class="secondary-button">
                        See Features
                    </a>

                </div>

            </div>


            <!-- Dashboard Preview -->
            <div class="dashboard">

                <div class="dashboard-top">

                    <div>
                        <small>PROJECT</small>
                        <h3>Website Redesign</h3>
                    </div>

                    <span class="active-badge">
                        Active
                    </span>

                </div>


                <div class="progress-area">

                    <div class="progress-label">
                        <span>Project Progress</span>
                        <strong>75%</strong>
                    </div>

                    <div class="progress-bar">
                        <div class="progress"></div>
                    </div>

                </div>


                <div class="tasks">

                    <div class="task">
                        <span class="check">✓</span>
                        <span>Design homepage</span>
                        <span class="priority low">Low</span>
                    </div>

                    <div class="task">
                        <span class="check">✓</span>
                        <span>Create components</span>
                        <span class="priority medium">
                            Medium
                        </span>
                    </div>

                    <div class="task">
                        <span class="empty-check">○</span>
                        <span>Build dashboard</span>
                        <span class="priority high">
                            High
                        </span>
                    </div>

                    <div class="task">
                        <span class="empty-check">○</span>
                        <span>Testing</span>
                        <span class="priority medium">
                            Medium
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- Features -->
    <section id="features" class="features">

        <div class="section-title">

            <p class="eyebrow">FEATURES</p>

            <h2>Everything your team needs</h2>

            <p>
                Simple tools to help your team stay organized
                and focused on getting work done.
            </p>

        </div>


        <div class="feature-grid">

            <div class="feature-card">
                <div class="feature-icon">📁</div>

                <h3>Project Management</h3>

                <p>
                    Create and organize projects so your team
                    always knows what they are working on.
                </p>
            </div>


            <div class="feature-card">
                <div class="feature-icon">✓</div>

                <h3>Task Tracking</h3>

                <p>
                    Create tasks, set priorities, and keep track
                    of what needs to be completed.
                </p>
            </div>


            <div class="feature-card">
                <div class="feature-icon">👥</div>

                <h3>Team Collaboration</h3>

                <p>
                    Assign tasks to team members and keep
                    everyone connected to the project.
                </p>
            </div>


            <div class="feature-card">
                <div class="feature-icon">📊</div>

                <h3>Progress Tracking</h3>

                <p>
                    Monitor project progress and see how much
                    work your team has completed.
                </p>
            </div>

        </div>

    </section>


    <!-- How It Works -->
    <section id="how-it-works" class="how-it-works">

        <div class="section-title">

            <p class="eyebrow">HOW IT WORKS</p>

            <h2>Get your team organized in three steps</h2>

        </div>


        <div class="steps">

            <div class="step">
                <div class="step-number">01</div>

                <h3>Create a Project</h3>

                <p>
                    Start a project and add the information
                    your team needs.
                </p>
            </div>


            <div class="step">
                <div class="step-number">02</div>

                <h3>Assign Tasks</h3>

                <p>
                    Create tasks and assign them to team members.
                </p>
            </div>


            <div class="step">
                <div class="step-number">03</div>

                <h3>Track Progress</h3>

                <p>
                    Update task status and monitor project progress.
                </p>
            </div>

        </div>

    </section>


    <!-- Call To Action -->
    <section class="cta">

        <h2>Ready to organize your team?</h2>

        <p>
            Start managing your projects and tasks with TaskForge.
        </p>

        <a href="#" class="primary-button">
            Get Started
        </a>

    </section>


    <!-- Footer -->
    <footer class="footer">

        <div class="footer-container">

            <div class="logo">
                Task<span>Forge</span>
            </div>

            <p>
                © 2026 TaskForge. Team project management made simple.
            </p>

        </div>

    </footer>

</div>